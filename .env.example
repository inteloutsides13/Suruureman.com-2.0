# Surrur-e-Man — Environment Variables
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.

# ----- Required -----

# PostgreSQL connection string
DATABASE_URL=

# Secret key used to sign JWT auth tokens (use a long random string)
JWT_SECRET=

# Secret key used for session signing
SESSION_SECRET=

# Port the API server listens on (set automatically by Replit)
PORT=

# ----- Optional -----

# Runtime environment: development | production
NODE_ENV=development

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Server-side Gemini API key for the public Urdu e'raab tool.
GEMINI_API_KEY=

# ----- Initial privileged-user seed (development/bootstrap only) -----
# Required only when the database has no users. Never commit real values.
SEED_DEV_PASSWORD=
SEED_ADMIN_PASSWORD=

# Comma-separated browser origins. Same-origin requests do not need this.
CORS_ORIGINS=

# ----- Radio Phase 2 foundations (disabled/unconfigured by default) -----
RADIO_ENABLED=false
RADIO_PUBLIC_STREAM_URL=
RADIO_SCHEDULE_TIMEZONE=Europe/Berlin
RADIO_ADMIN_PERMISSIONS=radio.audio.read
RADIO_INTERNAL_API_URL=
RADIO_MACHINE_ID=
RADIO_MACHINE_SECRET=
RADIO_STORAGE_PROVIDER=
RADIO_MONITORING_ENABLED=false
RADIO_ALERT_WEBHOOK_URL=
